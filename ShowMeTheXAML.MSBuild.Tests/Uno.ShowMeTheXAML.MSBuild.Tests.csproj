<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Matches the InternalsVisibleTo in BuildXamlDictionaryTask.cs -->
		<AssemblyName>ShowMeTheXAML.MSBuild.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<!-- The other sources in this folder belong to the upstream WPF test project -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Uno\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShowMeTheXAML.MSBuild\Uno.ShowMeTheXAML.MSBuild.csproj" />
	</ItemGroup>

</Project>
